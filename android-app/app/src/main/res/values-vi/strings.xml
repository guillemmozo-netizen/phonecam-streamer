    <!-- Welcome dialog (first launch only) -->
    <string name="welcome_title">Cảm ơn bạn đã ủng hộ ứng dụng độc lập này ❤️</string>
    <string name="welcome_message">PhoneCam đang được phát triển độc lập bởi một người.\n\nTrong các giai đoạn Alpha và Beta, chúng tôi muốn cảm ơn sự ủng hộ của bạn bằng cách mở khóa mọi tính năng Pro thông qua quảng cáo có thưởng.\n\nSự giúp đỡ của bạn khi thử nghiệm ứng dụng, gửi phản hồi và chia sẻ với người khác giúp chúng tôi tiếp tục cải thiện nó.\n\nCảm ơn bạn đã đồng hành cùng dự án ngay từ những ngày đầu.</string>
    <string name="welcome_button">Tiếp tục</string>

    <!-- Alpha/Beta Pro messaging (see AppPhase.kt) -->
    <string name="pro_ads_notice">Trong giai đoạn Alpha và Beta, mọi tính năng Pro đều có thể được mở khóa miễn phí bằng cách xem quảng cáo có thưởng.</string>
    <string name="pro_feature_locked_desc">Cài đặt này yêu cầu PhoneCam Pro — hãy xem quảng cáo trên màn hình camera để mở khóa</string>

