    <string name="ad_intro_description">4K60, बिना वॉटरमार्क और %2$d घंटे बिना विज्ञापन के अनलॉक करने के लिए लगातार %1$d छोटे विज्ञापन देखें — यह विज्ञापन %1$d में से %3$d है।</string>
    <string name="ad_intro_button">विज्ञापन %2$d में से %1$d देखें</string>
    <string name="ad_reward_celebration_title">%1$d घंटे का Pro जोड़ा गया</string>
    <string name="ad_reward_celebration_desc">इस स्वतंत्र ऐप को सपोर्ट करने के लिए धन्यवाद — बिना वॉटरमार्क के %1$d घंटे की 4K60 स्ट्रीमिंग का आनंद लें।</string>
