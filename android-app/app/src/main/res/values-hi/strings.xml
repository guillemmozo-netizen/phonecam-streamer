    <!-- Welcome dialog (first launch only) -->
    <string name="welcome_title">इस स्वतंत्र ऐप को सपोर्ट करने के लिए धन्यवाद ❤️</string>
    <string name="welcome_message">FrameCast को एक व्यक्ति द्वारा स्वतंत्र रूप से बनाया जा रहा है।\n\nAlpha और Beta चरणों के दौरान, हम आपके सपोर्ट के लिए धन्यवाद देना चाहते हैं और इसके लिए सभी Pro फीचर्स रिवॉर्ड वाले विज्ञापनों के ज़रिए उपलब्ध करा रहे हैं।\n\nऐप को टेस्ट करने, फ़ीडबैक भेजने और इसे दूसरों के साथ शेयर करने में आपकी मदद हमें इसे बेहतर बनाते रहने में सक्षम बनाती है।\n\nशुरुआत से ही इस प्रोजेक्ट का हिस्सा बनने के लिए धन्यवाद।</string>
    <string name="welcome_button">जारी रखें</string>

    <!-- Alpha/Beta Pro messaging (see AppPhase.kt) -->
    <string name="pro_ads_notice">Alpha और Beta के दौरान, सभी Pro फीचर्स रिवॉर्ड वाले विज्ञापन देखकर मुफ़्त में अनलॉक किए जा सकते हैं।</string>
    <string name="pro_feature_locked_desc">इस सेटिंग के लिए FrameCast Pro चाहिए — इसे अनलॉक करने के लिए कैमरा स्क्रीन पर विज्ञापन देखें</string>

