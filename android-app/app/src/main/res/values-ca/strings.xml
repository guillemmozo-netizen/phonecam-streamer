    <!-- Welcome dialog (first launch only) -->
    <string name="welcome_title">Gràcies per donar suport a aquesta aplicació independent ❤️</string>
    <string name="welcome_message">FrameCast està sent desenvolupada de manera independent per una sola persona.\n\nDurant les fases Alpha i Beta volem agrair-vos el vostre suport oferint totes les funcions Pro mitjançant anuncis amb recompensa.\n\nLa vostra ajuda provant l\'aplicació, enviant comentaris i compartint-la amb altres persones ens permet seguir millorant-la.\n\nGràcies per formar part del projecte des del principi.</string>
    <string name="welcome_button">Continua</string>

    <!-- Alpha/Beta Pro messaging (see AppPhase.kt) -->
    <string name="pro_ads_notice">Durant l\'Alpha i la Beta, totes les funcions Pro es poden desbloquejar gratuïtament mirant anuncis amb recompensa.</string>
    <string name="pro_feature_locked_desc">Aquest ajust requereix FrameCast Pro — mira anuncis a la pantalla de la càmera per desbloquejar-lo</string>

    <!-- Rewarded-ad flow -->
    <string name="ad_intro_title">Aconsegueix %1$d hores de Pro</string>
    <string name="ad_intro_description">Mira %1$d anuncis curts seguits per desbloquejar el 4K60, sense marca d\'aigua i sense anuncis durant %2$d hores — aquest és l\'anunci %3$d de %1$d.</string>
    <string name="ad_intro_button">Mira l\'anunci %1$d de %2$d</string>
    <string name="ad_reward_celebration_title">%1$dh de Pro afegides</string>
    <string name="ad_reward_celebration_desc">Gràcies per donar suport a aquesta aplicació independent — gaudeix de %1$dh de transmissió en 4K60 sense marca d\'aigua.</string>
    <string name="ad_progress_title">%1$d/%2$d vistos</string>
