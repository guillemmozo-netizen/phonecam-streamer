    <!-- Welcome dialog (first launch only) -->
    <string name="welcome_title">Merci de soutenir cette application indépendante ❤️</string>
    <string name="welcome_message">PhoneCam est développée de façon indépendante par une seule personne.\n\nPendant les phases Alpha et Beta, nous tenons à vous remercier de votre soutien en débloquant toutes les fonctionnalités Pro grâce aux publicités récompensées.\n\nVotre aide en testant l\'application, en envoyant des retours et en la partageant avec d\'autres personnes nous permet de continuer à l\'améliorer.\n\nMerci de faire partie du projet depuis le début.</string>
    <string name="welcome_button">Continuer</string>

