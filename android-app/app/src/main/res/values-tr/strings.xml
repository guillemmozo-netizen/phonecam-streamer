    <!-- Welcome dialog (first launch only) -->
    <string name="welcome_title">Bu bağımsız uygulamayı desteklediğin için teşekkürler ❤️</string>
    <string name="welcome_message">FrameCast tek bir kişi tarafından bağımsız olarak geliştiriliyor.\n\nAlpha ve Beta aşamalarında desteğin için teşekkür etmek amacıyla tüm Pro özelliklerini ödüllü reklamlar aracılığıyla sunuyoruz.\n\nUygulamayı test etmen, geri bildirim göndermen ve başkalarıyla paylaşman, onu geliştirmeye devam etmemizi sağlıyor.\n\nProjenin en başından beri bir parçası olduğun için teşekkürler.</string>
    <string name="welcome_button">Devam et</string>

    <!-- Alpha/Beta Pro messaging (see AppPhase.kt) -->
