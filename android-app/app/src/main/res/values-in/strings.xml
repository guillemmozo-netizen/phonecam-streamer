    <!-- Welcome dialog (first launch only) -->
    <string name="welcome_title">Terima kasih telah mendukung aplikasi independen ini ❤️</string>
    <string name="welcome_message">PhoneCam dikembangkan secara independen oleh satu orang.\n\nSelama fase Alpha dan Beta, kami ingin berterima kasih atas dukungan Anda dengan membuka semua fitur Pro melalui iklan berhadiah.\n\nBantuan Anda dalam menguji aplikasi, mengirim masukan, dan membagikannya kepada orang lain memungkinkan kami untuk terus menyempurnakannya.\n\nTerima kasih telah menjadi bagian dari proyek ini sejak awal.</string>
    <string name="welcome_button">Lanjutkan</string>

