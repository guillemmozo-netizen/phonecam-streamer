    <!-- Welcome dialog (first launch only) -->
    <string name="welcome_title">この独立系アプリを応援してくださりありがとうございます ❤️</string>
    <string name="welcome_message">FrameCastは、たった一人の開発者によって独立して開発されています。\n\nAlpha版とBeta版の期間中は、応援してくださる皆さまへの感謝として、リワード広告を見るだけですべてのPro機能をご利用いただけます。\n\nアプリのテスト、フィードバックの送信、そして周りの方への共有にご協力いただくことで、開発を続けていくことができます。\n\n最初からこのプロジェクトに参加してくださり、ありがとうございます。</string>
    <string name="welcome_button">続ける</string>

    <!-- Alpha/Beta Pro messaging (see AppPhase.kt) -->
    <string name="pro_ads_notice">AlphaおよびBeta期間中は、リワード広告を見るだけですべてのPro機能を無料で解除できます。</string>
    <string name="pro_feature_locked_desc">この設定にはFrameCast Proが必要です — カメラ画面で広告を見て解除してください</string>

    <!-- Rewarded-ad flow -->
    <string name="ad_intro_title">Pro %1$d時間を獲得</string>
    <string name="ad_intro_description">短い広告を%1$d本連続で見ると、4K60・透かしなし・広告なしを%2$d時間利用できます — これは%1$d本中%3$d本目の広告です。</string>
    <string name="ad_intro_button">広告 %2$d本中%1$d本目を見る</string>
    <string name="ad_reward_celebration_title">Pro %1$d時間を追加しました</string>
