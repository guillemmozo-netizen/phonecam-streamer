    <!-- Welcome dialog (first launch only) -->
    <string name="welcome_title">Bedankt voor het steunen van deze onafhankelijke app ❤️</string>
    <string name="welcome_message">FrameCast wordt onafhankelijk ontwikkeld door één persoon.\n\nTijdens de Alpha- en Bètafase willen we je bedanken voor je steun door alle Pro-functies vrij te geven via beloningsadvertenties.\n\nDoor de app te testen, feedback te sturen en hem met anderen te delen, help je ons de app te blijven verbeteren.\n\nBedankt dat je vanaf het begin deel uitmaakt van dit project.</string>
    <string name="welcome_button">Doorgaan</string>

