<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Full-screen camera preview.
         implementationMode="compatible" forces the TextureView path (proper
         GPU-filtered bilinear scaling) instead of the default "performance"
         SurfaceView/hardware-overlay path — at low resolutions (e.g. 360p
         upscaled to fill the screen) the hardware-overlay path can scale
         with a much cruder filter on some GPUs, producing a blocky "pixelate
         filter" look instead of the soft blur a genuinely low-res image
         should have when stretched up. Recording/streaming was never
         affected by this — it's a viewfinder-only rendering detail. -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:implementationMode="compatible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Viewfinder for the experimental Camera2 backend (Settings > Developer).
         PreviewView is a CameraX view and can only be fed by a CameraX Preview
         use case, so the Camera2 session needs a surface of its own. GONE (and
         costing nothing) unless that backend is actually running; the two are
         mutually exclusive because only one client can hold the camera. -->
    <!-- Constrained to the parent, NOT to previewView, and that is load-bearing.
         With 0dp the size comes entirely from the constraints, and
         startCamera2Backend sets previewView to GONE before showing this one.
         ConstraintLayout resolves a GONE view to a zero-size point, so anchoring
         all four edges to it collapsed this TextureView to 0x0: the camera still
         rendered into its SurfaceTexture (streaming ran at a full 60fps) but the
         view drew nothing, which is exactly the "preview goes black the moment
         you press Start" symptom. Measured on an S23 Ultra: screen brightness
         0.9 with Camera2 vs 86.2 with CameraX, and neither preview view present
         in the uiautomator tree because zero-size views are omitted from it. -->
    <TextureView
        android:id="@+id/camera2PreviewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Grid overlay (3x3 rule-of-thirds) -->
    <com.phonecam.streamer.ui.GridOverlay
        android:id="@+id/gridOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />

    <!-- Tap-to-focus indicator. Constrained to the parent's corner only to
         satisfy the layout pass — it is positioned programmatically (x/y set
         from the tap point in MainActivity) and hidden until then. -->
    <View
        android:id="@+id/focusIndicator"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/focus_indicator"
        android:visibility="gone"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Shown centred while a screen-capture session runs (the camera is
         released, so the viewfinder behind it is dark on purpose). -->
    <TextView
        android:id="@+id/screenModeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/screen_streaming_note"
        android:textColor="#99FFFFFF"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:drawablePadding="10dp"
        android:visibility="gone"
        app:drawableTopCompat="@drawable/ic_source_screen"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top bar: minimal, floating -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Recording indicator dot + text -->
        <View
            android:id="@+id/recDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_idle" />

        <TextView
            android:id="@+id/streamStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/not_streaming" />

        <TextView
            android:id="@+id/hdrBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:background="@drawable/badge_hdr"
            android:text="HDR"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:letterSpacing="0.05"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" />

        <!-- Capture-source selector: camera or screen. The icon mirrors the
             current choice; tapping opens a two-item popup (see
             MainActivity.showSourceMenu). -->
        <ImageButton
            android:id="@+id/sourceButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/btn_circle_dark"
            android:src="@drawable/ic_source_camera"
            android:contentDescription="@string/source_button_desc"
            android:scaleType="centerInside"
            android:padding="8dp"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/torchButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/btn_circle_dark"
            android:src="@drawable/ic_torch"
            android:contentDescription="@string/torch"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:visibility="gone"
            app:tint="#99FFFFFF" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/btn_circle_dark"
            android:src="@drawable/ic_gear"
            android:contentDescription="@string/settings"
            android:scaleType="centerInside"
            app:tint="@android:color/white"
            />
    </LinearLayout>

    <!-- Left side: 2-bar audio level meter, mirrors the right-side ISO/EV pill -->
    <LinearLayout
        android:id="@+id/audioMeterContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginStart="12dp"
        android:background="@drawable/pill_dark"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="70dp"
            android:layout_marginEnd="4dp">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#22FFFFFF" />
            <View
                android:id="@+id/audioMeterBarLeft"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_gravity="bottom"
                android:background="@color/accent_green" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="70dp">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#22FFFFFF" />
            <View
                android:id="@+id/audioMeterBarRight"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_gravity="bottom"
                android:background="@color/accent_green" />
        </FrameLayout>
    </LinearLayout>

    <!-- Right side: one chip per exposure control. The chips are all that stays
         on screen — each shows its own current value, so the state is readable
         at a glance, and tapping one slides its slider out into exposurePanel.
         The sliders used to be stacked here permanently, three rails deep,
         covering a third of the viewfinder's height for settings that are
         adjusted once and then watched. -->
    <LinearLayout
        android:id="@+id/cameraControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="8dp"
        android:background="@drawable/pill_dark"
        android:paddingHorizontal="4dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar">

        <!-- AE on: EV compensation only. AE off: true manual ISO + shutter. -->
        <TextView
            android:id="@+id/aeToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ae_label"
            android:textColor="@color/focus_ring"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:minWidth="36dp"
            android:gravity="center"
            android:padding="6dp" />

        <LinearLayout
            android:id="@+id/shutterChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:minWidth="40dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="5dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shutter_label"
                android:textColor="#88FFFFFF"
                android:textSize="8sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/shutterChipValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1/60"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/isoChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:minWidth="40dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="5dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/iso_label"
                android:textColor="#88FFFFFF"
                android:textSize="8sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/isoChipValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/evChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:minWidth="40dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ev_label"
                android:textColor="#88FFFFFF"
                android:textSize="8sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/evChipValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mfChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:minWidth="40dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="5dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manual_focus_label"
                android:textColor="#88FFFFFF"
                android:textSize="8sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/mfChipValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="∞"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <!-- The one slider, shared by whichever chip is open. Slides out from
         behind the rail and back; GONE the rest of the time, so nothing here
         costs viewfinder space or a measure pass while it is closed.
         Constrained to the rail, not the parent, so it tracks it. -->
    <LinearLayout
        android:id="@+id/exposurePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="6dp"
        android:background="@drawable/pill_dark"
        android:paddingHorizontal="8dp"
        android:paddingVertical="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/cameraControls"
        app:layout_constraintTop_toTopOf="@id/cameraControls"
        app:layout_constraintBottom_toBottomOf="@id/cameraControls">

        <TextView
            android:id="@+id/panelTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/iso_label"
            android:textColor="#BBFFFFFF"
            android:textSize="9sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="2dp" />

        <!-- rotation is a DRAW transform, not a layout one: a 180dp-wide
             SeekBar still measures 180dp wide after being turned upright, and
             the panel's wrap_content dutifully reserved all of it — a pill
             stretching a third of the way across the viewfinder for a slider
             30dp wide. This frame is the real, upright footprint; the child
             keeps its horizontal measurements and rotates inside it. -->
        <!-- 260dp, not 180: at 1/6-stop density the shutter has ~64 detents
             inside one sensor's range, and 180dp put them 2.8dp apart —
             finer than the control could actually be driven. Length is the
             only thing that buys back precision once the stops are this
             close, and this still fits between the top and bottom bars. -->
        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="260dp">

            <SeekBar
                android:id="@+id/panelSeekBar"
                android:layout_width="260dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:rotation="270"
                android:max="100"
                android:progress="50"
                android:thumbTint="@android:color/white"
                android:progressTint="#AAFFFFFF"
                android:progressBackgroundTint="#44FFFFFF"
                android:splitTrack="false" />
        </FrameLayout>

        <TextView
            android:id="@+id/panelValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:layout_marginTop="2dp" />

        <!-- Only ever set for a shutter slower than the session's frame
             interval: the sensor cannot deliver frames faster than it exposes
             them, so this is the fps that choice really allows. -->
        <TextView
            android:id="@+id/panelHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_amber"
            android:textSize="9sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:visibility="gone" />
    </LinearLayout>

    <!-- iOS-camera-style zoom chips, populated in code from the device database -->
    <LinearLayout
        android:id="@+id/zoomChipRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="4dp"
        android:background="@drawable/pill_dark"
        android:layout_marginBottom="10dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom bar: clean, centered -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Tier badge -->
        <TextView
            android:id="@+id/tierText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="3dp"
            android:background="@drawable/badge_free"
            android:textColor="#AAFFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/status_free_tier"
            android:layout_marginBottom="16dp" />

        <!-- Action row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Ad button (left), with a batch-progress badge at its corner -->
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/watchAdButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/watch_ad_button"
                    android:textColor="#AAFFFFFF"
                    android:textSize="11sp"
                    android:enabled="false"
                    app:cornerRadius="28dp"
                    app:backgroundTint="#33FFFFFF" />

                <TextView
                    android:id="@+id/adProgressBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="-2dp"
                    android:layout_marginEnd="-2dp"
                    android:minWidth="24dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:background="@drawable/badge_ad_progress"
                    android:text="0/3"
                    android:textColor="@color/surface_dark"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Record/Stream button (center, large) -->
            <FrameLayout
                android:id="@+id/toggleStreamButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="32dp"
                android:background="@drawable/rec_btn_idle"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/start_stream_button">

                <View
                    android:id="@+id/recBtnInner"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/rec_btn_inner_idle" />
            </FrameLayout>

            <!-- Flip camera button (right) -->
            <ImageButton
                android:id="@+id/flipCameraButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/btn_circle_dark"
                android:src="@drawable/ic_flip_camera"
                android:contentDescription="Flip camera"
                android:scaleType="centerInside"
                app:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
