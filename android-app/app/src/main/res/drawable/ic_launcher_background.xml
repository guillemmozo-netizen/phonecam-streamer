<?xml version="1.0" encoding="utf-8"?>
<!--
    The dark ground the mark sits on, with a soft glow behind the centre so
    the signal reads as emitting rather than as flat line-art.

    A vector rather than the previous <shape>: the gradient has to be centred
    on the same point as the foreground's mark (54,54 in a 108 viewport), and
    a shape drawable has no way to express that. Full 108x108 bleed, because
    the launcher masks the background and any inset would show as a hairline
    of wallpaper at the icon's edge.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="62">
                <item android:offset="0.0" android:color="#16233A" />
                <item android:offset="0.55" android:color="#0D1526" />
                <item android:offset="1.0" android:color="#070B14" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
