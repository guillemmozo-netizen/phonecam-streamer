    <!-- Welcome dialog (first launch only) -->
    <string name="welcome_title">Danke, dass du diese unabhängige App unterstützt ❤️</string>
    <string name="welcome_message">PhoneCam wird unabhängig von einer einzelnen Person entwickelt.\n\nWährend der Alpha- und Beta-Phase möchten wir uns für deine Unterstützung bedanken, indem wir alle Pro-Funktionen über Werbeprämien freischalten.\n\nDeine Hilfe beim Testen der App, beim Senden von Feedback und beim Teilen mit anderen ermöglicht es uns, sie weiter zu verbessern.\n\nDanke, dass du von Anfang an Teil des Projekts bist.</string>
    <string name="welcome_button">Weiter</string>

    <!-- Alpha/Beta Pro messaging (see AppPhase.kt) -->
    <string name="pro_ads_notice">Während der Alpha- und Beta-Phase können alle Pro-Funktionen kostenlos durch das Ansehen von Werbevideos freigeschaltet werden.</string>
    <string name="pro_feature_locked_desc">Diese Einstellung erfordert PhoneCam Pro — sieh dir Werbevideos auf dem Kamerabildschirm an, um sie freizuschalten</string>

    <!-- Rewarded-ad flow -->
    <string name="ad_intro_title">Verdiene %1$d Stunden Pro</string>
    <string name="ad_intro_description">Sieh dir %1$d kurze Werbevideos hintereinander an, um 4K60, kein Wasserzeichen und keine Werbung für %2$d Stunden freizuschalten — dies ist Anzeige %3$d von %1$d.</string>
    <string name="ad_intro_button">Anzeige %1$d von %2$d ansehen</string>
    <string name="ad_reward_celebration_title">%1$d Std. Pro hinzugefügt</string>
