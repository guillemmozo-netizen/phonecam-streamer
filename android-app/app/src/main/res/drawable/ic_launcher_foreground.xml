<?xml version="1.0" encoding="utf-8"?>
<!-- FrameCast mark: viewfinder corner brackets ("frame") around a cast/signal
     glyph ("cast").

     Everything sits inside x/y 30..78 of the 108 canvas, so the mark's outermost
     point (a bracket corner, stroke included) lands ~33.6 from centre — inside
     the 36 radius an adaptive icon's circular mask leaves visible, which is the
     tightest mask a launcher can apply.

     Arcs are written as cubic Béziers rather than SVG 'A' commands: a quarter
     circle is exact enough at k=0.5523, and cubics avoid depending on arc
     handling in VectorDrawable's path parser across OEM launchers. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Corner brackets -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M30,47 L30,38 C30,33.582 33.582,30 38,30 L47,30" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M61,30 L70,30 C74.418,30 78,33.582 78,38 L78,47" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M78,61 L78,70 C78,74.418 74.418,78 70,78 L61,78" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M47,78 L38,78 C33.582,78 30,74.418 30,70 L30,61" />

    <!-- Cast waves, radiating from the dot at 44.5,63.5 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M54.5,63.5 C54.5,57.977 50.023,53.5 44.5,53.5" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M62.5,63.5 C62.5,53.559 54.441,45.5 44.5,45.5" />

    <!-- Cast origin dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44.5,60.1 C46.378,60.1 47.9,61.622 47.9,63.5 C47.9,65.378 46.378,66.9 44.5,66.9 C42.622,66.9 41.1,65.378 41.1,63.5 C41.1,61.622 42.622,60.1 44.5,60.1 Z" />
</vector>
