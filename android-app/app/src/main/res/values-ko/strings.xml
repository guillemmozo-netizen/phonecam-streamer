    <!-- Welcome dialog (first launch only) -->
    <string name="welcome_title">이 독립 앱을 응원해 주셔서 감사합니다 ❤️</string>
    <string name="welcome_message">FrameCast은 한 사람이 독립적으로 개발하고 있습니다.\n\nAlpha 및 Beta 단계 동안, 여러분의 응원에 감사하는 마음으로 리워드 광고를 통해 모든 Pro 기능을 제공해 드립니다.\n\n앱을 테스트하고, 피드백을 보내고, 다른 사람들과 공유해 주시는 도움 덕분에 계속해서 앱을 개선해 나갈 수 있습니다.\n\n처음부터 이 프로젝트와 함께해 주셔서 감사합니다.</string>
    <string name="welcome_button">계속</string>

    <!-- Alpha/Beta Pro messaging (see AppPhase.kt) -->
    <string name="pro_ads_notice">Alpha 및 Beta 기간 동안에는 리워드 광고를 시청하는 것만으로 모든 Pro 기능을 무료로 잠금 해제할 수 있습니다.</string>
    <string name="pro_feature_locked_desc">이 설정에는 FrameCast Pro가 필요합니다 — 카메라 화면에서 광고를 시청하면 잠금 해제됩니다</string>

    <!-- Rewarded-ad flow -->
    <string name="ad_intro_title">Pro %1$d시간 받기</string>
    <string name="ad_intro_description">짧은 광고 %1$d개를 연속으로 시청하면 4K60, 워터마크 없음, 광고 없음을 %2$d시간 동안 이용할 수 있습니다 — 현재 %1$d개 중 %3$d번째 광고입니다.</string>
    <string name="ad_intro_button">광고 %2$d개 중 %1$d번째 보기</string>
    <string name="ad_reward_celebration_title">Pro %1$d시간 추가됨</string>
    <string name="ad_reward_celebration_desc">이 독립 앱을 응원해 주셔서 감사합니다 — 워터마크 없는 4K60 스트리밍을 %1$d시간 동안 즐겨보세요.</string>
    <string name="ad_progress_title">%2$d개 중 %1$d개 시청함</string>
