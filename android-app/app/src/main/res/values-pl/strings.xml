    <!-- Welcome dialog (first launch only) -->
    <string name="welcome_title">Dziękujemy za wsparcie tej niezależnej aplikacji ❤️</string>
    <string name="welcome_message">FrameCast jest tworzony niezależnie przez jedną osobę.\n\nW fazach Alpha i Beta chcemy podziękować za Wasze wsparcie, udostępniając wszystkie funkcje Pro poprzez reklamy z nagrodą.\n\nWasza pomoc w testowaniu aplikacji, przesyłaniu opinii i udostępnianiu jej innym pozwala nam ją stale ulepszać.\n\nDziękujemy za bycie częścią projektu od samego początku.</string>
    <string name="welcome_button">Kontynuuj</string>

    <!-- Alpha/Beta Pro messaging (see AppPhase.kt) -->
    <string name="pro_ads_notice">W fazach Alpha i Beta wszystkie funkcje Pro można odblokować bezpłatnie, oglądając reklamy z nagrodą.</string>
    <string name="pro_feature_locked_desc">To ustawienie wymaga FrameCast Pro — obejrzyj reklamy na ekranie aparatu, aby je odblokować</string>

