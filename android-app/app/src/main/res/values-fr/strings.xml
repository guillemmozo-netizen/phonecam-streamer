    <!-- Welcome dialog (first launch only) -->
    <string name="welcome_title">Merci de soutenir cette application indépendante ❤️</string>
    <string name="welcome_message">FrameCast est développée de façon indépendante par une seule personne.\n\nPendant les phases Alpha et Beta, nous tenons à vous remercier de votre soutien en débloquant toutes les fonctionnalités Pro grâce aux publicités récompensées.\n\nVotre aide en testant l\'application, en envoyant des retours et en la partageant avec d\'autres personnes nous permet de continuer à l\'améliorer.\n\nMerci de faire partie du projet depuis le début.</string>
    <string name="welcome_button">Continuer</string>

    <!-- Alpha/Beta Pro messaging (see AppPhase.kt) -->
    <string name="pro_ads_notice">Pendant l\'Alpha et la Beta, toutes les fonctionnalités Pro peuvent être débloquées gratuitement en regardant des publicités récompensées.</string>
    <string name="pro_feature_locked_desc">Ce réglage nécessite FrameCast Pro — regardez des publicités sur l\'écran de la caméra pour le débloquer</string>

