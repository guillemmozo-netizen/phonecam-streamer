    <!-- Welcome dialog (first launch only) -->
    <string name="welcome_title">Terima kasih telah mendukung aplikasi independen ini ❤️</string>
    <string name="welcome_message">FrameCast dikembangkan secara independen oleh satu orang.\n\nSelama fase Alpha dan Beta, kami ingin berterima kasih atas dukungan Anda dengan membuka semua fitur Pro melalui iklan berhadiah.\n\nBantuan Anda dalam menguji aplikasi, mengirim masukan, dan membagikannya kepada orang lain memungkinkan kami untuk terus menyempurnakannya.\n\nTerima kasih telah menjadi bagian dari proyek ini sejak awal.</string>
    <string name="welcome_button">Lanjutkan</string>

    <!-- Alpha/Beta Pro messaging (see AppPhase.kt) -->
    <string name="pro_ads_notice">Selama Alpha dan Beta, semua fitur Pro dapat dibuka secara gratis dengan menonton iklan berhadiah.</string>
    <string name="pro_feature_locked_desc">Pengaturan ini memerlukan FrameCast Pro — tonton iklan di layar kamera untuk membukanya</string>

