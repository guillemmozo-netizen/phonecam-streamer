    <!-- Welcome dialog (first launch only) -->
    <string name="welcome_title">Obrigado por apoiar este aplicativo independente ❤️</string>
    <string name="welcome_message">O FrameCast está sendo desenvolvido de forma independente por uma única pessoa.\n\nDurante as fases Alpha e Beta, queremos agradecer o seu apoio oferecendo todos os recursos Pro por meio de anúncios recompensados.\n\nSua ajuda testando o aplicativo, enviando feedback e compartilhando com outras pessoas nos permite continuar melhorando-o.\n\nObrigado por fazer parte do projeto desde o início.</string>
    <string name="welcome_button">Continuar</string>

    <!-- Alpha/Beta Pro messaging (see AppPhase.kt) -->
