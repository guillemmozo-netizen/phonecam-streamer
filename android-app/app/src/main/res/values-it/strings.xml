    <!-- Welcome dialog (first launch only) -->
    <string name="welcome_title">Grazie per aver sostenuto questa app indipendente ❤️</string>
    <string name="welcome_message">PhoneCam è sviluppata in modo indipendente da una sola persona.\n\nDurante le fasi Alpha e Beta vogliamo ringraziarti del tuo supporto offrendo tutte le funzioni Pro tramite annunci con premio.\n\nIl tuo aiuto nel testare l\'app, inviare feedback e condividerla con altre persone ci permette di continuare a migliorarla.\n\nGrazie per far parte del progetto fin dall\'inizio.</string>
    <string name="welcome_button">Continua</string>

    <!-- Alpha/Beta Pro messaging (see AppPhase.kt) -->
    <string name="pro_ads_notice">Durante l\'Alpha e la Beta, tutte le funzioni Pro possono essere sbloccate gratuitamente guardando annunci con premio.</string>
    <string name="pro_feature_locked_desc">Questa impostazione richiede PhoneCam Pro — guarda gli annunci nella schermata della fotocamera per sbloccarla</string>

