    <!-- Welcome dialog (first launch only) -->
    <string name="welcome_title">Спасибо за поддержку этого независимого приложения ❤️</string>
    <string name="welcome_message">FrameCast разрабатывается независимо одним человеком.\n\nВо время фаз Alpha и Beta мы хотим поблагодарить вас за поддержку, открыв все функции Pro через рекламу с вознаграждением.\n\nВаша помощь в тестировании приложения, отправке отзывов и распространении среди других людей позволяет нам продолжать его улучшать.\n\nСпасибо, что вы с нами с самого начала проекта.</string>
    <string name="welcome_button">Продолжить</string>

    <!-- Alpha/Beta Pro messaging (see AppPhase.kt) -->
    <string name="pro_ads_notice">Во время Alpha и Beta все функции Pro можно бесплатно открыть, посмотрев рекламу с вознаграждением.</string>
    <string name="pro_feature_locked_desc">Для этой настройки требуется FrameCast Pro — посмотрите рекламу на экране камеры, чтобы разблокировать её</string>

